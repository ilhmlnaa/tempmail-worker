{
  "name": "tempmail-worker",
  "version": "2.0.0",
  "description": "MAILLDEZ-compatible temp mail API + Web Dashboard on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create tempmail-db",
    "db:init": "wrangler d1 execute tempmail-db --remote --file=src/db/schema.sql",
    "generate:names": "node scripts/generate-anime-names.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "hono": "^4.6.5",
    "lucide": "^0.468.0",
    "swagger-ui-dist": "^5.17.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.115.0"
  }
}
